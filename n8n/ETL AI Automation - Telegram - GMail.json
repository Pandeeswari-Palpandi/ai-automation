    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map(item => {\n  let raw = item.json.output ?? item.json.text ?? item.json.response ?? item.json;\n\n  // Convert AI output to a string\n  if (typeof raw !== \"string\") {\n    raw = JSON.stringify(raw);\n  }\n\n  // Remove Markdown JSON code fences\n  raw = raw\n    .replace(/```json\\s*/gi, \"\")\n    .replace(/```\\s*/g, \"\")\n    .trim();\n\n  // Parse the AI-generated JSON\n  let email;\n\n  try {\n    email = JSON.parse(raw);\n  } catch (error) {\n    // Handle output that contains escaped JSON as a string\n    try {\n      email = JSON.parse(\n        raw.replace(/^\"|\"$/g, \"\").replace(/\\\\\"/g, '\"')\n      );\n    } catch (innerError) {\n      throw new Error(\"Invalid AI email JSON: \" + error.message);\n    }\n  }\n\n  // Clean text values\n  const cleanText = value =>\n    String(value ?? \"\")\n      .replace(/\\\\n/g, \"\\n\")\n      .replace(/\\r\\n?/g, \"\\n\")\n      .trim();\n\n  const result = {\n    To: cleanText(email.To),\n    Subject: cleanText(email.Subject),\n    body: cleanText(email.body)\n  };\n\n  return { json: result };\n});\n"
      },
