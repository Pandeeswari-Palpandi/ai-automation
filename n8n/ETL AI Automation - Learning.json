    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this Student Enrollment row and return only a json object. \n\nRow data : {{JSON.stringify($json)}}\n\nRules :\n- Name : Title case (Pandeeswari P)\n- Email : If invalid set INVALID_EMAIL\n- Phone : if less than 10 digits set MISSING\n- Course : only Python or Machine Learning or Data Science\n- Fee_Paid : yes/YES = true, no/No = false\n- City : Title case, empty = UNKNOWN\n- Enrolled_Date : convert to YYYY-MM-DD\nReturn only raw JSON. No explanation. No Markdown.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -400,
        -256
      ],
      "id": "6ed9d931-2e6a-4b2a-a0ad-0d1e5a39211e",
      "name": "Basic LLM Chain1"
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nreturn items.map((item) => {\n  let data = item.json;\n\n  // 1. Extract AI output (adjust keys based on your AI node)\n  let output =\n    data.output ??\n    data.text ??\n    data.response ??\n    data.message ??\n    data;\n\n  // 2. Parse JSON string if needed\n  if (typeof output === \"string\") {\n    output = output\n      .replace(/```json\\s*/gi, \"\")\n      .replace(/```\\s*/g, \"\")\n      .trim();\n\n    try {\n      output = JSON.parse(output);\n    } catch (error) {\n      // Keep unparseable text for inspection\n      return {\n        json: {\n          success: false,\n          error: \"Invalid JSON from AI\",\n          rawOutput: output\n        }\n      };\n    }\n  }\n\n  // 3. Clean string values recursively\n  function clean(value) {\n    if (typeof value === \"string\") {\n      return value\n        .replace(/\\s+/g, \" \")\n        .replace(/[\\u200B-\\u200D\\uFEFF]/g, \"\")\n        .trim();\n    }\n\n    if (Array.isArray(value)) {\n      return value.map(clean);\n    }\n\n    if (value !== null && typeof value === \"object\") {\n      const result = {};\n\n      for (const [key, val] of Object.entries(value)) {\n        const cleanKey = key.trim();\n\n        // Skip empty keys and undefined values\n        if (cleanKey && val !== undefined) {\n          result[cleanKey] = clean(val);\n        }\n      }\n\n      return result;\n    }\n\n    return value;\n  }\n\n  const cleanedData = clean(output);\n\n  // 4. Return structured JSON\n  return {\n    json: {\n      success: true,\n      data: cleanedData\n    }\n  };\n});\n"
      },
