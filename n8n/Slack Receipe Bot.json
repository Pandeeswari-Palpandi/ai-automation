    {
      "parameters": {
        "jsCode": "const raw = $json.text || '';\n\nlet data;\n\ntry {\n  data = JSON.parse(\n    raw\n      .replace(/```json\\s*/i, '')\n      .replace(/```\\s*/g, '')\n      .trim()\n  );\n} catch (error) {\n  throw new Error('AI response is not valid JSON');\n}\n\n// Recipe comes directly from the AI response\nconst recipe = data.recipe || 'Recipe';\n\n// Products is an array\nconst products = data.products || [];\n\nconst ingredients = products\n  .map(item => `• ${item.ingredient}: ${item.quantity}`)\n  .join('\\n');\n\nconst message =\n  `🍽️ Ingredients for ${recipe}\\n\\n${ingredients}`;\n\nreturn [\n  {\n    json: {\n      recipe,\n      channel: $('Edit Fields').first().json.channel,\n      message\n    }\n  }\n];"
      },
