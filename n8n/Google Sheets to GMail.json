      "parameters": {
        "jsCode": "const rows = $input.all();\n\nif (rows.length === 0) {\n  return [\n    {\n      json: {\n        subject: \"Google Sheet Update\",\n        body: `\n          <p>Hi,</p>\n          <p>There is no data available in the Google Sheet.</p>\n          <p>Regards,<br>Your Automation Bot</p>\n        `\n      }\n    }\n  ];\n}\n\nlet body = `\n  <p>Hi,</p>\n\n  <p>Here is the latest data from the Google Sheet:</p>\n\n  <ul>\n`;\n\nrows.forEach((item) => {\n  const data = item.json;\n\n  body += `\n    <li>\n      <strong>Name:</strong> ${data.Name || \"N/A\"}<br>\n      <strong>Course:</strong> ${data.Course || \"N/A\"}<br>\n      <strong>Status:</strong> ${data.Status || \"N/A\"}\n    </li>\n    <br>\n  `;\n});\n\nbody += `\n  </ul>\n\n  <p>Regards,<br>\n  <strong>Your Automation Bot</strong></p>\n`;\n\nreturn [\n  {\n    json: {\n      subject: \"Data Summary from Google Sheet\",\n      body: body\n    }\n  }\n];"
      },
